# ===========================================
# .env.production.example — Template
# ===========================================

# --- Application Settings ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
PROJECT_NAME=SILA-System

# --- Database Configuration ---
POSTGRES_DB=sila_db
POSTGRES_HOST=db
POSTGRES_USER=sila_prod
POSTGRES_PASSWORD=ChangeMe_Use_Secure_Password
DATABASE_URL=postgresql://sila_prod:ChangeMe@db:5432/sila_db
ASYNC_DATABASE_URL=postgresql+asyncpg://sila_prod:ChangeMe@db:5432/sila_db

# --- Redis & Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_Use_Secure_Password
CELERY_BROKER_URL=redis://:ChangeMe@redis:6379/0
CELERY_RESULT_BACKEND=redis://:ChangeMe@redis:6379/0

# --- Backend Security ---
SECRET_KEY=ChangeMe_Use_Secure_64_Char_String
AUTH_SECRET_KEY=ChangeMe_Use_Another_Secure_String
ALGORITHM=HS256
# 90 dias em minutos (90 * 24 * 60 = 129600)
ACCESS_TOKEN_EXPIRE_MINUTES=129600
# Refresh token também ajustado para 90 dias
REFRESH_TOKEN_EXPIRE_DAYS=90

# --- CORS & Frontend ---
BACKEND_CORS_ORIGINS=["https://seu-dominio.com","https://api.seu-dominio.com"]
ALLOWED_ORIGINS=["https://seu-dominio.com"]
VITE_API_BASE_URL=https://api.seu-dominio.com/api/v1
NODE_ENV=production

# --- Monitoring & Observability ---
ENABLE_METRICS=true
SENTRY_DSN=
LOG_LEVEL=WARNING

# --- Email Configuration (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_api_key
SMTP_FROM_NAME="SILA System"
SMTP_FROM_EMAIL=noreply@seu-dominio.com

# --- Storage (Minio / S3) ---
STORAGE_BUCKET=sila-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
