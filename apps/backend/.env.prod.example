# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# CRITICAL: Never commit this file to version control
# Use .env.prod.example as a template

# Database Configuration
POSTGRES_DB=sila_db
POSTGRES_USER=sila_user
POSTGRES_PASSWORD=Angola2025_Secure_Prod_Change_This!
DATABASE_URL=postgresql+asyncpg://sila_user:Angola2025_Secure_Prod_Change_This!@db:5432/sila_db
ASYNC_DATABASE_URL=postgresql+asyncpg://sila_user:Angola2025_Secure_Prod_Change_This!@db:5432/sila_db

# Application Configuration
DEBUG=false
ENVIRONMENT=production
PROJECT_NAME=SILA System
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_FOR_PRODUCTION_USE
AUTH_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_VERY_LONG_RANDOM_STRING
BACKEND_CORS_ORIGINS=["https://sila.gov.ao","https://www.sila.gov.ao"]

# Server Configuration
WORKERS=4
HOST=0.0.0.0
PORT=8000

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# OCR Configuration
TESSERACT_LANG=por
OCR_CONFIDENCE_THRESHOLD=60

# Email Configuration (if applicable)
SMTP_HOST=smtp.gov.ao
SMTP_PORT=587
SMTP_USER=noreply@sila.gov.ao
SMTP_PASSWORD=change_this
SMTP_FROM=noreply@sila.gov.ao

# Monitoring (optional - Sentry)
SENTRY_DSN=

# Payment Webhook Secret
PAYMENT_WEBHOOK_SECRET=change_this_webhook_secret_key
