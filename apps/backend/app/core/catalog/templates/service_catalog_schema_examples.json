{
  "services": [
    {
      "service_code": "SAUDE_MARCACAO_CONSULTA",
      "name": "Marcacao de Consulta",
      "category": "saude",
      "description": "Agendamento de consultas e exames",
      "price": 0,
      "form_schema": {
        "version": "1.0",
        "groups": [
          {
            "key": "identificacao",
            "label": "Identificacao",
            "fields": [
              { "key": "citizen_name", "label": "Nome completo", "type": "text", "required": true },
              { "key": "bi_number", "label": "Numero BI", "type": "bi", "mask": "bi", "required": true },
              { "key": "birth_date", "label": "Data de nascimento", "type": "date", "required": true }
            ]
          },
          {
            "key": "consulta",
            "label": "Detalhes da consulta",
            "fields": [
              {
                "key": "specialty",
                "label": "Especialidade",
                "type": "select",
                "required": true,
                "options": ["clinica_geral", "pediatria", "cardiologia", "ginecologia"]
              },
              {
                "key": "is_urgent",
                "label": "Caso urgente",
                "type": "checkbox",
                "required": false,
                "helper": "Marque se houver risco imediato."
              },
              {
                "key": "urgency_reason",
                "label": "Descricao da urgencia",
                "type": "textarea",
                "required": false,
                "depends_on": { "field": "is_urgent", "value": true }
              },
              {
                "key": "preferred_shift",
                "label": "Periodo preferido",
                "type": "radio",
                "required": true,
                "options": ["manha", "tarde", "noite"]
              },
              {
                "key": "supporting_files",
                "label": "Anexos (exames anteriores)",
                "type": "upload",
                "required": false,
                "multiple": true
              }
            ]
          }
        ],
        "validations": [
          { "field": "bi_number", "type": "regex", "pattern": "^[0-9A-Z]{14}$", "message": "Numero BI invalido." }
        ],
        "dependencies": [
          {
            "field": "is_urgent",
            "value": true,
            "requires": ["urgency_reason"],
            "message": "Descreva a urgencia quando marcar como urgente."
          }
        ]
      }
    },
    {
      "service_code": "JUSTICA_CERTIDAO_NASCIMENTO",
      "name": "Certidao de Nascimento",
      "category": "justica",
      "description": "Emissao de certidao de nascimento",
      "price": 500,
      "form_schema": {
        "version": "1.0",
        "groups": [
          {
            "key": "requerente",
            "label": "Dados do requerente",
            "fields": [
              { "key": "citizen_name", "label": "Nome completo", "type": "text", "required": true },
              { "key": "bi_number", "label": "Numero BI", "type": "bi", "mask": "bi", "required": true },
              { "key": "phone", "label": "Contacto", "type": "text", "required": true }
            ]
          },
          {
            "key": "certidao",
            "label": "Detalhes da certidao",
            "fields": [
              {
                "key": "certificate_reason",
                "label": "Motivo",
                "type": "select",
                "required": true,
                "options": ["escolar", "emprego", "passaporte", "outro"]
              },
              {
                "key": "other_reason",
                "label": "Outro motivo",
                "type": "text",
                "required": false,
                "depends_on": { "field": "certificate_reason", "value": "outro" }
              },
              {
                "key": "delivery_mode",
                "label": "Entrega",
                "type": "radio",
                "required": true,
                "options": ["digital", "presencial"]
              },
              {
                "key": "supporting_files",
                "label": "Anexos",
                "type": "upload",
                "required": true,
                "multiple": true
              }
            ]
          }
        ],
        "validations": [
          { "field": "supporting_files", "type": "min_files", "min": 1, "message": "Envie pelo menos 1 anexo." }
        ],
        "dependencies": [
          {
            "field": "certificate_reason",
            "value": "outro",
            "requires": ["other_reason"],
            "message": "Explique o motivo quando selecionar 'outro'."
          }
        ]
      }
    },
    {
      "service_code": "FINANCAS_IMPOSTO_LIQUIDACAO",
      "name": "Liquidacao de Impostos",
      "category": "financas",
      "description": "Liquidacao de impostos e taxas",
      "price": 1500,
      "form_schema": {
        "version": "1.0",
        "groups": [
          {
            "key": "identificacao",
            "label": "Identificacao fiscal",
            "fields": [
              { "key": "citizen_name", "label": "Nome completo", "type": "text", "required": true },
              { "key": "nif", "label": "Numero de NIF", "type": "nif", "mask": "nif", "required": true },
              { "key": "tax_year", "label": "Ano fiscal", "type": "number", "required": true }
            ]
          },
          {
            "key": "pagamento",
            "label": "Detalhes do pagamento",
            "fields": [
              {
                "key": "tax_type",
                "label": "Tipo de imposto",
                "type": "select",
                "required": true,
                "options": ["irs", "iva", "imposto_selo", "outro"]
              },
              {
                "key": "tax_amount",
                "label": "Valor estimado",
                "type": "number",
                "required": true
              },
              {
                "key": "payment_method",
                "label": "Metodo de pagamento",
                "type": "radio",
                "required": true,
                "options": ["referencia", "transferencia", "presencial"]
              },
              {
                "key": "bank_receipt",
                "label": "Comprovativo bancario",
                "type": "upload",
                "required": false,
                "multiple": false,
                "depends_on": { "field": "payment_method", "value": "transferencia" }
              }
            ]
          }
        ],
        "validations": [
          { "field": "nif", "type": "regex", "pattern": "^\\d{10}$", "message": "NIF invalido." },
          { "field": "tax_amount", "type": "min", "min": 1, "message": "Valor minimo 1." },
          { "field": "tax_year", "type": "range", "min": 2010, "max": 2035, "message": "Ano fiscal invalido." }
        ],
        "dependencies": [
          {
            "field": "payment_method",
            "value": "transferencia",
            "requires": ["bank_receipt"],
            "message": "Anexe o comprovativo quando escolher transferencia."
          }
        ]
      }
    }
  ]
}
