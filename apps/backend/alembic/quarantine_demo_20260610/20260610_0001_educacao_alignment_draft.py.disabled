    # Prefer referencing `locations(id)` (canonical geographies) when present.
    if "territory_closure" not in inspector.get_table_names():
        if "locations" in inspector.get_table_names():
            # Create closure with FKs to `locations(id)` if locations exists
            op.create_table(
                "territory_closure",
                sa.Column("ancestor_id", postgresql.UUID(as_uuid=True), sa.ForeignKey("locations.id", ondelete="CASCADE"), nullable=False),
                sa.Column("descendant_id", postgresql.UUID(as_uuid=True), sa.ForeignKey("locations.id", ondelete="CASCADE"), nullable=False),
