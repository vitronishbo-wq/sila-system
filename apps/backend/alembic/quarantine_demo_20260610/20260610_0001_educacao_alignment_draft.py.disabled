        # If locations exists, attempt to backfill closure from locations.parent_id
        if "locations" in inspector.get_table_names():
            try:
                op.execute("""
                WITH RECURSIVE r AS (
                    SELECT id AS ancestor_id, id AS descendant_id, 0 AS depth
                    FROM locations
                    UNION ALL
                    SELECT l.parent_id AS ancestor_id, r.descendant_id, r.depth + 1
                    FROM locations l
                    JOIN r ON l.id = r.ancestor_id
                    WHERE l.parent_id IS NOT NULL
