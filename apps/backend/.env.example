# ==================== DATABASE ====================
# NUNCA commite credenciais reais de banco de dados!
# Use variáveis de ambiente em produção
# Desenvolvimento local: Use .env (gitignored)

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=sila_user
DB_PASSWORD=your_secure_password_here
DB_NAME=sila_system

# DATABASE_URL format: postgresql://user:password@host:port/database
# Para desenvolvimento local, usar .env com valores reais
DATABASE_URL=postgresql://sila_user:your_secure_password_here@127.0.0.1:5432/sila_system

# ==================== API ====================
API_HOST=localhost
API_PORT=8000
API_ENV=development

# ==================== FRONTEND ====================
FRONTEND_HOST=localhost
FRONTEND_PORT=5173

# ==================== AUTH ====================
# NUNCA commite SECRET_KEY!
# Usar secrets manager em produção (AWS Secrets Manager, Vault)

# SECRET_KEY deve ser:
#  - Gerado com: python -c "import secrets; print(secrets.token_urlsafe(32))"
#  - Único por ambiente
#  - Rotacionado regularmente
#  - Gestionado por Secrets Manager
SECRET_KEY=your_super_secret_key_here_minimum_32_chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json  # ou: standard

# ==================== OBSERVABILITY ====================
# Nome da variável que contém a lista CSV de caminhos a excluir das métricas
OBS_EXCLUDE_PATHS_ENV_NAME=OBS_EXCLUDE_PATHS
# Caminhos (CSV) excluídos das métricas Prometheus (opcional)
# Exemplo: "/metrics,/api/health,/system/health"
OBS_EXCLUDE_PATHS=/metrics,/api/health,/system/health

# ==================== SECURITY ====================
# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH"]
CORS_ALLOW_HEADERS=["*"]

# ==================== FEATURES ====================
DEBUG=false
ENVIRONMENT=development

# ============================================================================
# 🔐 SEGURANÇA - LEIA COM ATENÇÃO
# ============================================================================
#
# NUNCA commite este ficheiro com valores reais (.env é gitignored)
# SEMPRE use variáveis de ambiente em PRODUÇÃO
#
# Desenvolvimento Local:
#   1. Copie este ficheiro para .env: cp .env.example .env
#   2. Edite .env com valores locais
#   3. NUNCA commite .env
#
# Produção - AWS Secrets Manager:
#   aws secretsmanager create-secret --name sila/backend/db-password...
#
# Produção - HashiCorp Vault:
#   vault kv put secret/sila/backend db_password=...
#
# Produção - Docker/Kubernetes:
#   Usar --env-file ou ConfigMaps + Secrets
#
# Para setup automático seguro:
#   ./setup_dev_env.sh
#
# ============================================================================
