# =========================
# Database Configuration
# =========================
ASYNC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME_TEST

# =========================
# Security
# =========================
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# OIDC / Keycloak
# =========================
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_DISCOVERY_URL=
OIDC_ALGORITHM=RS256
OIDC_CLIENT_SECRET=
OIDC_PUBLIC_KEY=
OIDC_STRICT=1
OIDC_JWKS_TTL=600

# =========================
# Keycloak (Core Auth)
# =========================
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=

# =========================
# OIDC Provider (Internal)
# =========================
OIDC_PROVIDER_ISSUER=
OIDC_PROVIDER_AUDIENCE=
OIDC_PROVIDER_ALGORITHM=RS256
OIDC_PROVIDER_TOKEN_TTL=3600
OIDC_PROVIDER_PRIVATE_KEY=
OIDC_PROVIDER_PUBLIC_KEY=
OIDC_PROVIDER_PRIVATE_KEY_PATH=
OIDC_PROVIDER_PUBLIC_KEY_PATH=
OIDC_PROVIDER_KEY_DIR=.secrets/oidc

# =========================
# Environment
# =========================
ENVIRONMENT=development
DEBUG=true
DATABASE_ECHO=false

# =========================
# CORS
# =========================
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
