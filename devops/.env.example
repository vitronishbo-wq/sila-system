# =========================================
# Variáveis de Ambiente - Docker Compose
# Sistema SILA
# =========================================
# Copie este arquivo para .env e ajuste conforme necessário
# cp .env.example .env

# =========================================
# PostgreSQL Database
# =========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sila
DB_PORT=5434

# =========================================
# Backend FastAPI
# =========================================
# Database URLs
DATABASE_URL=postgresql://postgres:postgres@db:5432/sila
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sila

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
BACKEND_PORT=8000

# =========================================
# Frontend Nginx
# =========================================
FRONTEND_PORT=80

# =========================================
# Build Options
# =========================================
# Forçar rebuild sem cache (0 ou 1)
FORCE_REBUILD=0

# =========================================
# Compose Project
# =========================================
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=sila-devops
