# Dockerfile for Alert Handler Service - Phase 18.2

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements/requirements.txt .
COPY requirements/requirements-dev.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --upgrade \
    fastapi>=0.104.0 \
    uvicorn[standard]>=0.24.0 \
    pydantic>=2.5.0 \
    pydantic-settings>=2.1.0 \
    httpx>=0.25.0 \
    python-multipart>=0.0.6

# Copy application files
COPY apps/backend/app/core/observability/alert_handler.py /app/alert_handler.py
COPY apps/backend/app/core/observability/anomaly_detector.py /app/anomaly_detector.py

# Create logs directory
RUN mkdir -p /app/logs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV ALERT_HISTORY_SIZE=10000
ENV ALERT_DEDUPLICATION_TTL=3600

# Expose port
EXPOSE 8080

# Run application
CMD ["uvicorn", "alert_handler:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
