KEYCLOAK_ADMIN=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db.example.com:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me

KC_HOSTNAME=auth.example.com
KC_HOSTNAME_STRICT=true
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded

KC_HTTP_ENABLED=false
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/certs/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/certs/tls.key

KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_LOG_LEVEL=INFO
