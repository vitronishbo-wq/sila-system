#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Uso:
  ./gmx run-local
  ./gmx env-print
  ./gmx url
  ./gmx status
  ./gmx open
  ./gmx open frontend

Variáveis úteis:
  ENV_MODE=host|docker|auto ./gmx url
  ENV_DEBUG=1 ./gmx env-print
  GMX_API_PORT=8003 ./gmx url
  GMX_URL_PRIORITY=bridge,local ./gmx url
  GMX_URL_DEBUG=1 ./gmx url
  ./gmx status
EOF
}

open_url() {
  local target="${1:-api}"
  local url_flag="--active-api"

  if [[ "$target" == "frontend" ]]; then
    url_flag="--active-frontend"
  elif [[ "$target" != "api" ]]; then
    echo "Alvo inválido para open: $target" >&2
    exit 1
  fi

  local resolved_url
  if ! resolved_url="$(ENV_MODE="${ENV_MODE:-auto}" "$ROOT_DIR/scripts/dev/print_runtime_urls.sh" "$url_flag")"; then
    echo "Nenhuma URL ativa encontrada para '$target'. Rode './gmx url' para inspecionar as opções." >&2
    exit 1
  fi

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$resolved_url" >/dev/null 2>&1 && exit 0
  fi

  if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command "Start-Process '$resolved_url'" >/dev/null 2>&1 && exit 0
  fi

  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /C start "" "$resolved_url" >/dev/null 2>&1 && exit 0
  fi

  echo "Não foi possível abrir automaticamente. URL ativa: $resolved_url" >&2
  exit 1
}

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
  run-local)
    exec make -C "$ROOT_DIR" run-local "$@"
    ;;
  env-print)
    exec make -C "$ROOT_DIR" env-print "$@"
    ;;
  url)
    exec "$ROOT_DIR/scripts/dev/print_runtime_urls.sh" "$@"
    ;;
  status)
    exec "$ROOT_DIR/scripts/dev/print_runtime_status.sh" "$@"
    ;;
  open)
    open_url "${1:-api}"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Comando inválido: $COMMAND" >&2
    usage >&2
    exit 1
    ;;
esac
