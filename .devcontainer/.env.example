# ============================================================================
# SILA DevContainer Environment Configuration Template
# ============================================================================
# 
# ⚠️ IMPORTANT: Copy this to .env and fill in your actual values
#    NEVER commit the .env file with real credentials!
#
# Setup:
#   cp .devcontainer/.env.example .devcontainer/.env
#   # Edit .env with your credentials
#   docker compose -f .devcontainer/docker-compose.yml up
#
# ============================================================================

# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=sila_user
POSTGRES_PASSWORD=Trumanmarcelo_1983
POSTGRES_DB=sila_db

# Azure / OpenAI API Keys
# ============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Azure Configuration (for managed identity / Key Vault)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_KEYVAULT_URL=

# Optional: Advanced Configuration
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Redis user (optional, default no auth)
REDIS_PASSWORD=

# Database pool settings (for high concurrency)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# API Configuration
API_DEBUG=false
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=3600

# Feature Flags
FEATURE_ASYNC_PROCESSING=true
FEATURE_CACHE_ENABLED=true
FEATURE_AUDIT_LOGGING=true
