# ========================
# SILA SYSTEM - ENVIRONMENT CONFIGURATION EXAMPLE
# ========================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env for development
# 2. Copy this file to .env.development for development-specific overrides
# 3. For testing, use .env.test (auto-loaded by pytest)
# 4. For production, create .env.production (never commit to git)

# ✅ DATABASE CONFIGURATION
# PostgreSQL is the only supported database
# Development/Testing uses localhost:5432
# Production should use a managed database service
DATABASE_URL=postgresql://sila_user:PASSWORD@localhost:5432/sila_db
ASYNC_DATABASE_URL=postgresql+asyncpg://sila_user:PASSWORD@localhost:5432/sila_db
TEST_DATABASE_URL=postgresql://sila_user:PASSWORD@localhost:5432/sila_test
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://sila_user:PASSWORD@localhost:5432/sila_db

POSTGRES_DB=sila_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sila_user
POSTGRES_PASSWORD=PASSWORD
DATABASE_ECHO=False

# ✅ SECURITY CONFIGURATION
AUTH_SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_HASH_ROUNDS=12

# ✅ FALLBACK ADMIN FOR DEVELOPMENT (disable in production)
ALLOW_FALLBACK_ADMIN=true
FALLBACK_ADMIN_PASSWORD=adm123

# ✅ CORS & FRONTEND CONFIGURATION
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development
FRONTEND_TARGET=dev

# ✅ APPLICATION CONFIGURATION
PROJECT_NAME=SILA-System
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PYTHONPATH=backend
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ✅ UPLOAD & FILES CONFIGURATION
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,txt

# ✅ RATE LIMITING
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=false

# ✅ FEATURE FLAGS
FEATURE_MONITORING=true
FEATURE_BACKUP=true
FEATURE_AUTO_HEALER=true
TELEMETRY_ENABLED=false

# ✅ BACKUP CONFIGURATION
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# ✅ CACHE CONFIGURATION
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=PASSWORD

# ✅ QUEUE CONFIGURATION
CELERY_BROKER_URL=redis://localhost:6379/1

# ✅ MONITORING CONFIGURATION
PROMETHEUS_GATEWAY=http://localhost:9090
GRAFANA_PASSWORD=PASSWORD
JAEGER_ENDPOINT=http://localhost:14268

# ✅ MINIO CONFIGURATION
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=sila_minio_admin
MINIO_ROOT_PASSWORD=PASSWORD
MINIO_ACCESS_KEY=sila_minio_admin
MINIO_SECRET_KEY=PASSWORD

# ✅ SSL CONFIGURATION
SSL_CERT_PATH=./devops/ssl/cert.pem
SSL_KEY_PATH=./devops/ssl/key.pem

# ✅ SYSTEM IDENTIFICATION
SILA_SYSTEM_ID=sila-2025

# ✅ BNA INTEGRATION CONFIGURATION
BNA_API_KEY=your-bna-api-key
BNA_API_URL=https://api.bna.ao
BNA_ENVIRONMENT=sandbox
MUNICIPALITY_ACCOUNT=AO06004000000000000012345

# ✅ PAYMENT CONFIGURATION
DEFAULT_CURRENCY=AOA
PAYMENT_TIMEOUT_SECONDS=300
PAYMENT_RETRY_ATTEMPTS=3
