# ===========================================
# SILA Frontend - Dockerfile Smart Multi-Target
# Suporte a desenvolvimento (hot reload) e produção
# ===========================================

# ===========================================
# Base Stage - Dependências comuns
# ===========================================
FROM node:20-alpine AS base

LABEL maintainer="SILA System <silahbo@gmail.com>"
LABEL description="SILA System Frontend - Smart Multi-Target Build"

# Instalar dependências do sistema
RUN apk add --no-cache curl git tzdata

# Configurar timezone
ENV TZ=Africa/Luanda
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# Copiar arquivos de configuração do workspace
COPY frontend/package.json ./
COPY frontend/package-lock.json* ./
COPY frontend/packages/ ./packages/
COPY frontend/apps/web/ ./apps/web/

# Instalar dependências
RUN npm ci --only=production=false && \
    npm install @rollup/rollup-linux-x64-musl --save-optional

# ===========================================
# Development Stage - Hot Reload
# ===========================================
FROM base AS dev

LABEL stage="development"

# Variáveis de ambiente para desenvolvimento
ENV NODE_ENV=development
ENV VITE_HMR_PORT=5173
ENV VITE_HMR_HOST=0.0.0.0

# Expor porta do Vite dev server
EXPOSE 5173

# Healthcheck para desenvolvimento
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5173/ || exit 1

# Comando para desenvolvimento com hot reload
CMD ["npm", "run", "dev", "--workspace=@sila-system/web", "--", "--host", "0.0.0.0", "--port", "5173"]

# ===========================================
# Builder Stage - Build para produção
# ===========================================
FROM base AS builder

LABEL stage="builder"

# Variáveis de ambiente para build
ENV NODE_ENV=production

# Build da aplicação
RUN npm run build --workspace=@sila-system/web

# Verificar se o build foi criado
RUN ls -la apps/web/dist/ || (echo "❌ Build falhou - dist/ não encontrado" && exit 1)

# ===========================================
# Runtime Stage - Produção com Nginx
# ===========================================
FROM nginx:alpine AS runtime

LABEL stage="production"
LABEL maintainer="SILA System <silahbo@gmail.com>"
LABEL description="SILA System Frontend - Production Server"
LABEL version="3.0.0"

# Instalar dependências
RUN apk add --no-cache \
    curl \
    tzdata \
    jq

# Configurar timezone
ENV TZ=Africa/Luanda
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Criar diretórios necessários
RUN mkdir -p /var/log/nginx /var/cache/nginx

# Copiar arquivos buildados
COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html/

# Criar configuração nginx otimizada
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Handle SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
EOF

# Configurar permissões
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx

# Expor porta
EXPOSE 80

# Healthcheck para produção
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Comando para produção
CMD ["nginx", "-g", "daemon off;"]

# ===========================================
# Metrics Stage - Servidor de métricas
# ===========================================
FROM base AS metrics

LABEL stage="metrics"

# Criar servidor de métricas simples
RUN cat > apps/web/metrics-server.js << 'EOF'
const express = require('express');
const app = express();
const port = 5173;

// Métricas básicas
let metrics = {
    requests_total: 0,
    uptime_seconds: 0,
    memory_usage: 0
};

const startTime = Date.now();

// Middleware para contar requests
app.use((req, res, next) => {
    metrics.requests_total++;
    next();
});

// Endpoint de métricas no formato Prometheus
app.get('/metrics', (req, res) => {
    metrics.uptime_seconds = Math.floor((Date.now() - startTime) / 1000);
    metrics.memory_usage = process.memoryUsage().heapUsed;

    const prometheusMetrics = `
# HELP sila_frontend_requests_total Total number of requests
# TYPE sila_frontend_requests_total counter
sila_frontend_requests_total ${metrics.requests_total}

# HELP sila_frontend_uptime_seconds Uptime in seconds
# TYPE sila_frontend_uptime_seconds gauge
sila_frontend_uptime_seconds ${metrics.uptime_seconds}

# HELP sila_frontend_memory_usage_bytes Memory usage in bytes
# TYPE sila_frontend_memory_usage_bytes gauge
sila_frontend_memory_usage_bytes ${metrics.memory_usage}
`;

    res.set('Content-Type', 'text/plain');
    res.send(prometheusMetrics);
});

// Health check
app.get('/health', (req, res) => {
    res.json({ status: 'healthy', uptime: metrics.uptime_seconds });
});

app.listen(port, '0.0.0.0', () => {
    console.log(`📊 Metrics server running on port ${port}`);
});
EOF

# Instalar express para o servidor de métricas
RUN npm install express

EXPOSE 5173

CMD ["node", "apps/web/metrics-server.js"]
