backend/venv/
backend/.venv/

# Specifico: frontend (se tiver node_modules, já está em Node.js section)
# frontend/venv/
# frontend/.venv/

# Ficheiros de configuração com segredos (manter apenas .env.example)
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
