# ===========================================
# .env.production.example — Template
# ===========================================
# Copie para .env.production e edite com
# valores específicos do seu environment
# ===========================================

# ===========================
# Application Settings
# ===========================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=SILA-System

# ===========================
# Database Configuration
# ===========================
# IMPORTANTE: Alterar POSTGRES_PASSWORD!
POSTGRES_DB=sila_db
POSTGRES_USER=sila_user
POSTGRES_PASSWORD=ChangeMe-Usar-openssl-rand-base64-32

# ===========================
# Redis Configuration
# ===========================
# IMPORTANTE: Alterar REDIS_PASSWORD!
REDIS_PASSWORD=ChangeMe-Usar-openssl-rand-base64-32

# ===========================
# Backend Security
# ===========================
# IMPORTANTE: Alterar SECRET_KEY!
SECRET_KEY=ChangeMe-Usar-openssl-rand-base64-64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# CORS Configuration
# ===========================
# Alterar para seu domínio em produção
BACKEND_CORS_ORIGINS=http://localhost:80,http://127.0.0.1:80,http://frontend,https://seu-dominio.com

# ===========================
# Frontend Configuration
# ===========================
# Alterar para seu domínio em produção
VITE_API_BASE_URL=http://localhost/api/v1
NODE_ENV=production

# ===========================
# Monitoring & Observability
# ===========================
ENABLE_METRICS=true
SENTRY_DSN=

# ===========================
# Optional: SMTP for Email
# ===========================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-app
# SMTP_FROM=noreply@seu-dominio.com

# ===========================
# Optional: AWS S3 (File Storage)
# ===========================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=sila-production
# AWS_S3_REGION=us-east-1

# ===========================
# Gerar Senhas Seguras:
# ===========================
# openssl rand -base64 32   # PostgreSQL, Redis
# openssl rand -base64 64   # SECRET_KEY
