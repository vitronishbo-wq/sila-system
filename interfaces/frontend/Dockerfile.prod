FROM node:20-alpine as builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production --no-audit
COPY . .
RUN npm run build

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY infrastructure/docker/frontend.conf /etc/nginx/conf.d/default.conf
RUN addgroup -g 1000 silagroup && \
    adduser -D -u 1000 -G silagroup silauser && \
    chown -R silauser:silagroup /usr/share/nginx/html && \
    chown -R silauser:silagroup /var/cache/nginx && \
    chown -R silauser:silagroup /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R silauser:silagroup /var/run/nginx.pid
USER silauser
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]